<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar <%= titulo %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/">Sistema CRUD</a>
        <div class="navbar-nav ms-auto flex-row gap-3">
            <a class="nav-link text-white" href="/clientes">Clientes</a>
            <a class="nav-link text-white" href="/fornecedores">Fornecedores</a>
            <a class="nav-link text-white" href="/produtos">Produtos</a>
        </div>
    </div>
</nav>
<main class="container py-4">
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="mb-4">
            <h1 class="h3">Editar <%= titulo.toLowerCase() %></h1>
            <a href="/<%= rota %>" class="text-decoration-none">Voltar para a listagem</a>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form action="/<%= rota %>/editar/<%= registro.id %>" method="POST">
            <div class="mb-3">
                <label for="nome" class="form-label">Nome</label>
                <input type="text" id="nome" name="nome" class="form-control" value="<%= registro.nome %>" required>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" id="email" name="email" class="form-control" value="<%= registro.email %>" required>
            </div>
            <div class="mb-3">
                <label for="telefone" class="form-label">Telefone</label>
                <input type="text" id="telefone" name="telefone" class="form-control" value="<%= registro.telefone %>">
            </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Salvar</button>
                        <a href="/<%= rota %>" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

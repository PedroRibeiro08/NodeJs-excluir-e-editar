<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema CRUD</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/">Sistema CRUD</a>
        <div class="navbar-nav ms-auto flex-row gap-3">
            <a class="nav-link text-white" href="/clientes">Clientes</a>
            <a class="nav-link text-white" href="/fornecedores">Fornecedores</a>
            <a class="nav-link text-white" href="/produtos">Produtos</a>
        </div>
    </div>
</nav>
<main class="container py-4">
<div class="p-4 p-md-5 mb-4 bg-white rounded-3 shadow-sm">
    <h1 class="display-6">Sistema CRUD</h1>
    <p class="lead">Gerenciamento de clientes, fornecedores e produtos.</p>
</div>
<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h5 mb-3">Integrantes da dupla</h2>
        <ul class="mb-4">
            <% nomesDupla.forEach(nome => { %>
                <li><%= nome %></li>
            <% }) %>
        </ul>
        <h2 class="h5 mb-3">Entidades</h2>
        <div class="d-flex flex-wrap gap-2">
            <a href="/clientes" class="btn btn-primary">Clientes</a>
            <a href="/fornecedores" class="btn btn-primary">Fornecedores</a>
            <a href="/produtos" class="btn btn-primary">Produtos</a>
        </div>
    </div>
</div>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

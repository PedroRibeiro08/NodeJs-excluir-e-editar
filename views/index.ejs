<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema CRUD</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/styles.css" rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/">Sistema CRUD</a>
        <div class="navbar-nav ms-auto flex-row gap-3">
            <a class="nav-link text-white" href="/clientes">Clientes</a>
            <a class="nav-link text-white" href="/fornecedores">Fornecedores</a>
            <a class="nav-link text-white" href="/produtos">Produtos</a>
        </div>
    </div>
</nav>
<main class="container py-4">
<section class="dashboard-intro">
    <div>
        <p class="eyebrow">Painel de gestão</p>
        <h1>Visão geral</h1>
        <p>Clientes, fornecedores e produtos em um só lugar.</p>
    </div>
</section>
<section class="entity-grid" aria-label="Áreas do sistema">
    <% resumo.forEach((entidade, indice) => { %>
        <a class="entity-card" href="/<%= entidade.rota %>">
            <span class="entity-mark" aria-hidden="true"><%= ['CL', 'FO', 'PR'][indice] %></span>
            <span>
                <h2><%= entidade.titulo %></h2>
                <p><strong><%= entidade.total %></strong> <%= entidade.total === 1 ? 'registro' : 'registros' %></p>
            </span>
            <span class="entity-arrow" aria-hidden="true">&#8594;</span>
        </a>
    <% }) %>
</section>
<footer class="team-strip">
    <span><strong>Integrantes</strong></span>
    <span><%= nomesDupla.join(' · ') %></span>
</footer>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/styles.css" rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/">Sistema CRUD</a>
        <div class="navbar-nav ms-auto flex-row gap-3">
            <a class="nav-link text-white" href="/clientes">Clientes</a>
            <a class="nav-link text-white" href="/fornecedores">Fornecedores</a>
            <a class="nav-link text-white" href="/produtos">Produtos</a>
        </div>
    </div>
</nav>
<main class="container py-4">
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1"><%= titulo %></h1>
        <p class="text-secondary mb-0">Gerencie os registros cadastrados.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="record-count"><%= dados.length %> <%= dados.length === 1 ? 'registro' : 'registros' %></span>
        <a href="/<%= rota %>/criar" class="btn btn-primary">Novo cadastro</a>
    </div>
</div>
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <% if (dados.length === 0) { %>
            <div class="empty-state"><strong>Nenhum registro cadastrado</strong>Comece adicionando o primeiro registro.</div>
        <% } else { %>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                        <% campos.forEach(campo => { %>
                            <th><%= rotulos[campo] %></th>
                        <% }) %>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% dados.forEach(registro => { %>
                            <tr>
                                <% campos.forEach(campo => { %>
                                    <td><%= campo === 'preco' ? Number(registro[campo]).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) : registro[campo] %></td>
                                <% }) %>
                                <td class="text-nowrap">
                                    <a href="/<%= rota %>/editar/<%= registro.id %>" class="btn btn-warning btn-sm">Editar</a>
                                    <form action="/<%= rota %>/excluir/<%= registro.id %>" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Deseja excluir este registro?')">Excluir</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
